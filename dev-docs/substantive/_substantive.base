filters:
  and:
    - type == "decision"
    - system == "obsidian-track-changes"
    - file.name != "_substantive-template"
    - file.name != "_design-decisions-template"
properties:
  file.name:
    displayName: Decision
  title:
    displayName: Title
  kind:
    displayName: Kind
  working_by:
    displayName: Agent on it
  question:
    displayName: Question
  recommendation:
    displayName: Recommendation
  unblocks:
    displayName: Unblocks
  asked_by:
    displayName: Asked by
  asked_at:
    displayName: Asked
  status:
    displayName: Status
  _human_verdict:
    displayName: Lane
  weight:
    displayName: Weight
  snooze_until:
    displayName: Snooze until
  previous_verdict:
    displayName: Verdict (before the agent's move)
  moved_at:
    displayName: Moved by the agent
  moved_by:
    displayName: Moved by
  waiting_on:
    displayName: Waiting on
  revisit_when:
    displayName: Revisit when
  human_note:
    displayName: Note
  human_words:
    displayName: Human's words
  relayed_by:
    displayName: Relayed by
  applied_at:
    displayName: Applied
  applied_how:
    displayName: How applied
  undo:
    displayName: Undo
views:
  - type: kanban
    name: 1 · DESIGN DECISIONS
    filters:
      and:
        - status != "withdrawn"
        - status != "draft"
        - kind != "discussion"
        - _human_verdict != "processed"
        - _human_verdict != "agents drafting"
        - _human_verdict != "agent editing"
        - _human_verdict != "agent drafting"
    groupBy:
      property: _human_verdict
      direction: ASC
    groupOrder:
      - documents to review
      - new decisions
      - returning decisions
      - yes, show me
      - yes, just do it
      - no
      - revise proposal
      - revise card
      - snoozed
      - later
      - after POC
      - after MVP
      - talk
      - agent working
      - agent waiting
      - agent scheduled
    order:
      - title
      - file.name
      - kind
      - weight
      - working_by
      - asked_by
      - recommendation
      - previous_verdict
      - moved_at
      - waiting_on
      - revisit_when
      - unblocks
      - asked_at
  - type: table
    name: 2 · OPEN
    filters:
      or:
        - status == "open"
        - status == "provisional"
    order:
      - file.name
      - title
      - question
      - asked_by
      - _human_verdict
      - recommendation
      - unblocks
      - asked_at
      - applied_how
      - undo
    sort:
      - property: asked_at
        direction: ASC
  - type: table
    name: 3 · ANSWERED, NOT APPLIED
    filters:
      and:
        - status != "applied"
        - status != "withdrawn"
        - status != "draft"
        - _human_verdict != ""
        - _human_verdict != "agents drafting"
        - _human_verdict != "agent editing"
        - _human_verdict != "agent drafting"
        - _human_verdict != "documents to review"
        - _human_verdict != "to review"
        - _human_verdict != "new decisions"
        - _human_verdict != "new"
        - _human_verdict != "returning decisions"
        - _human_verdict != "returning"
        - _human_verdict != "snoozed"
        - _human_verdict != "agent scheduled"
    order:
      - file.name
      - title
      - question
      - _human_verdict
      - previous_verdict
      - human_note
      - waiting_on
      - asked_by
  - type: table
    name: 4 · PROCESSED
    filters:
      and:
        - status == "applied"
    order:
      - file.name
      - title
      - _human_verdict
      - question
      - previous_verdict
      - human_words
      - relayed_by
      - applied_at
      - applied_how
    sort:
      - property: applied_at
        direction: DESC
  - type: table
    name: 5 · SCHEDULED AND WAITING
    filters:
      or:
        - _human_verdict == "agent scheduled"
        - _human_verdict == "agent waiting"
    order:
      - file.name
      - title
      - question
      - _human_verdict
      - revisit_when
      - waiting_on
      - moved_at
      - asked_by
  - type: kanban
    name: 6 · TOPICS TO DISCUSS
    filters:
      and:
        - status != "withdrawn"
        - status != "draft"
        - kind == "discussion"
        - _human_verdict != "processed"
        - _human_verdict != "agents drafting"
        - _human_verdict != "agent editing"
        - _human_verdict != "agent drafting"
    groupBy:
      property: _human_verdict
      direction: ASC
    groupOrder:
      - documents to review
      - new decisions
      - returning decisions
      - yes, show me
      - yes, just do it
      - no
      - revise proposal
      - revise card
      - snoozed
      - later
      - after POC
      - after MVP
      - talk
      - agent working
      - agent waiting
      - agent scheduled
    order:
      - title
      - file.name
      - kind
      - weight
      - working_by
      - asked_by
      - recommendation
      - previous_verdict
      - moved_at
      - waiting_on
      - revisit_when
      - unblocks
      - asked_at
